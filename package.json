  "allowScripts": {
    "electron@22.3.27": true,
    "esbuild@0.27.7": true
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "tailwindcss": "4.1.17",
